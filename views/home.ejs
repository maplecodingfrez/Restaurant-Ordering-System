<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Welcome | ระบบสั่งอาหาร</title>
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css" />
    <script src="js/bootstrap.bundle.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Anonymous+Pro:ital,wght@0,400;0,700;1,400;1,700&family=Chakra+Petch:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Cinzel:wght@400..900&family=Epunda+Slab:ital,wght@0,300..900;1,300..900&family=Exo+2:ital,wght@0,100..900;1,100..900&family=Goldman:wght@400;700&family=IBM+Plex+Sans+Thai+Looped:wght@100;200;300;400;500;600;700&family=Itim&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&family=Mali:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&family=Pridi:wght@200;300;400;500;600;700&family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap"
        rel="stylesheet">
    <style>
        body {
            background: linear-gradient(180deg, #f0f0f0 25%, #fbe9e7 100%);
            min-height: 100vh;
            font-family: "Kodchasan", sans-serif;
        }

        .fw-bold.mb-3 {
            font-size: 32px;
            padding-bottom: 1rem;
        }

        .home-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 24px #0001;
            padding: 2.5rem 2rem;
            max-width: 400px;
            width: 100%;
            margin: 40px auto;

        }

        .logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 1rem;
        }

        .table-select {
            margin-top: 2rem;
        }

        .category-list {
            margin: 2rem auto 0 auto;
        }

        .category-link {
            cursor: pointer;
        }

        footer {
            background: #222;
            color: #fff;
            padding: 2rem 0 1rem 0;
            margin-top: 3rem;
        }
    </style>
</head>

<body>
    <%- include('header') %>

        <!-- Food Categories -->
        <div class="category-list text-center container" style="max-width: 900px;">
            <h4 class="fw-bold mb-3">หมวดหมู่อาหาร</h4>
            <div class="row justify-content-center">
                <% if (typeof data !=='undefined' && data.length> 0) { %>
                    <% data.forEach(function(category) { %>
                        <div class="col-12 col-md-6 col-lg-4 mb-3">
                            <div class="card h-100 shadow-sm">
                                <img src="/categories/<%= category.category_id %>.jpg" class="card-img-top"
                                    alt="<%= category.category_name %>" style="height:180px;object-fit:cover;">
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <h5 class="card-title mb-3">
                                        <%= category.category_name %>
                                    </h5>
                                    <a href="/menu?table_id=<%= table_id %>#section<%= category.category_id %>"
                                        class="btn btn-danger w-100 category-link">
                                        ดูเมนูในหมวดนี้
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="col-12 text-muted">ไม่มีหมวดหมู่อาหาร</div>
                                <% } %>
            </div>
        </div>

        <%- include('cart') %>

            <!-- Footer -->
            <%- include('footer') %>
</body>

</html>