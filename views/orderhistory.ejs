<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ประวัติการสั่งอาหารทั้งหมด</title>
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css" />
    <script src="js/bootstrap.bundle.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Anonymous+Pro:ital,wght@0,400;0,700;1,400;1,700&family=Chakra+Petch:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Cinzel:wght@400..900&family=Epunda+Slab:ital,wght@0,300..900;1,300..900&family=Exo+2:ital,wght@0,100..900;1,100..900&family=Goldman:wght@400;700&family=IBM+Plex+Sans+Thai+Looped:wght@100;200;300;400;500;600;700&family=Itim&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&family=Mali:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&family=Pridi:wght@200;300;400;500;600;700&family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: "Kodchasan", sans-serif;
            background: linear-gradient(to bottom right, #f0f0f0, #fbe9e7);
        }
    </style>
</head>

<body>
    <%- include('staffHeader.ejs') %>
        <div class="container mt-4">
            <h2 class="mb-4">ประวัติการสั่งอาหารทั้งหมด</h2>
            <div class="accordion" id="orderHistoryAccordion">
                <% const page=Number(typeof currentPage !=='undefined' ? currentPage : 1); const pageSize=15; const
                    totalOrders=orders.length; const totalPages=Math.ceil(totalOrders / pageSize); const startIdx=(page
                    - 1) * pageSize; const endIdx=Math.min(startIdx + pageSize, totalOrders); const
                    pagedOrders=orders.slice(startIdx, endIdx); %>
                    <% if (pagedOrders.length===0) { %>
                        <div class="text-center text-muted py-5">ไม่มีรายการ</div>
                        <% } else { %>
                            <% pagedOrders.forEach(function(order) { const items=orderItems[order.order_id] || []; if
                                (items.length===0) return; %>
                                <div class="accordion-item mb-2">
                                    <h2 class="accordion-header" id="heading<%= order.order_id %>">
                                        <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapse<%= order.order_id %>"
                                            aria-expanded="false" aria-controls="collapse<%= order.order_id %>">
                                            ออเดอร์ #<%= order.order_id %> | โต๊ะ: <%= typeof order.table_number
                                                    !=='undefined' ? order.table_number : order.table_id %> | เวลา: <%=
                                                        order.start_time || order.created_at %> | สถานะการชำระเงิน: <%=
                                                            order.paid ? 'ชำระแล้ว' : 'ยังไม่ชำระ' %>
                                        </button>
                                    </h2>
                                    <div id="collapse<%= order.order_id %>" class="accordion-collapse collapse"
                                        aria-labelledby="heading<%= order.order_id %>"
                                        data-bs-parent="#orderHistoryAccordion">
                                        <div class="accordion-body">
                                            <ul class="list-group mb-3">
                                                <% items.forEach(function(item) { 
                                                    let basePrice = item.price || 0;
                                                    let displayPrice = basePrice;
                                                    if (item.size === 'L') displayPrice = basePrice * 1.2;
                                                    else if (item.size === 'S') displayPrice = basePrice * 0.8;
                                                    // Default (M or undefined) is basePrice
                                                %>
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <span>
                                                            <%= item.item_name %>
                                                                <span class="badge bg-info ms-2">
                                                                    <%= item.size %>
                                                                </span>
                                                                <span class="badge bg-secondary ms-2">x<%= item.quantity
                                                                        %></span>
                                                        </span>
                                                        <span>
                                                            <span class="text-success me-2">
                                                                <%= displayPrice ?
                                                                    Number(displayPrice).toLocaleString('en-US',
                                                                    {minimumFractionDigits: 2}) : '0.00' %> บาท
                                                            </span>
                                                            <span>สถานะ: <%= item.status_name %></span>
                                                        </span>
                                                    </li>
                                                    <% }); %>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } %>
            </div>
            <!-- Pagination controls -->
            <% if (totalPages> 1) { %>
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <% for(let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= i === page ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>
                    </ul>
                </nav>
                <% } %>
        </div>
</body>

</html>